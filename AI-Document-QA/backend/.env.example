# PostgreSQL Database Connection URL
# Format: postgresql+psycopg2://username:password@host:port/database_name
# Replace placeholder values with your actual PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/ai_document_qa

# ── JWT authentication ──────────────────────────────────────────────────────
# Used by app/core/security.py to sign and verify access tokens.
# NEVER put a real secret in source control — generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The backend refuses to issue/verify tokens while JWT_SECRET is unset.
JWT_SECRET=replace_with_a_long_random_secret_here

# Token signing algorithm. Supported: HS256 (default), HS384, HS512.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (default 30 when omitted).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM Provider ────────────────────────────────────────────────────────────
# Which backend generates RAG answers: "ollama" (default, local/private) or
# "openrouter" (cloud, OpenAI-compatible API).
LLM_PROVIDER=ollama

# ── Ollama LLM Configuration ────────────────────────────────────────────────
# Base URL for the Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# LLM model name (default: llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Request timeout in seconds for LLM generation (default: 120)
OLLAMA_TIMEOUT=120

# ── OpenRouter Configuration (only used when LLM_PROVIDER=openrouter) ───────
# OpenAI-compatible chat endpoint. Default base URL shown below.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to request from OpenRouter.
OPENROUTER_MODEL=openrouter/free

# Request timeout in seconds (default: 120).
OPENROUTER_TIMEOUT=120

# API key from your OpenRouter account. NEVER commit a real key —
# set this in your deployment environment or a local .env file only.
OPENROUTER_API_KEY=

# ── Storage Configuration ───────────────────────────────────────────────────
# Centralized directory paths for uploaded PDF documents and the FAISS vector index.
# For local development, these can be omitted — the backend automatically falls
# back to local directories (backend/documents and backend/vector_store).
# In containerized/production deployments, point these to a persistent volume mount:
DOCUMENTS_DIR=/app/storage/documents
VECTOR_STORE_DIR=/app/storage/vector_store

