# PostgreSQL Database Connection URL
# Format: postgresql+psycopg2://username:password@host:port/database_name
# Replace placeholder values with your actual PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/ai_document_qa

# ── JWT authentication ──────────────────────────────────────────────────────
# Used by app/core/security.py to sign and verify access tokens.
# NEVER put a real secret in source control — generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The backend refuses to issue/verify tokens while JWT_SECRET is unset.
JWT_SECRET=replace_with_a_long_random_secret_here

# Token signing algorithm. Supported: HS256 (default), HS384, HS512.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (default 30 when omitted).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
