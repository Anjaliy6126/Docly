# Frontend environment template — copy to .env.local for local overrides.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# VITE_* values are inlined at BUILD TIME; set them in the deployment
# platform's build environment (e.g. Vercel project settings) for production.
#
# Base URL of the FastAPI backend. Local development can omit this —
# the app falls back to http://127.0.0.1:8000 when unset.
VITE_API_URL=http://127.0.0.1:8000
